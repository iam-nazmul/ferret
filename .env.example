# ENVIRONMENT=development
ENVIRONMENT=local
# ENVIRONMENT=production

# LLM + embeddings
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ENVIRONMENT=local only: gemma3:4b on a locally hosted Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ferret
LANGSMITH_TRACING=true

# Data
DATABASE_URL=postgresql+asyncpg://ferret:ferret@localhost:5432/ferret
REDIS_URL=redis://localhost:6379/0
RERANKER_URL=http://localhost:8081

# Auth
OIDC_ISSUER=https://example.okta.com/oauth2/default
OIDC_AUDIENCE=ferret
OIDC_GROUP_CLAIM=groups
OIDC_ADMIN_GROUP=ferret-admins
AUTH_DISABLED=false

# Storage
S3_ENDPOINT_URL=
AWS_REGION=us-east-1

# API
API_BASE_URL=http://localhost:8000
