FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 HF_HOME=/srv/.cache
WORKDIR /srv

RUN pip install --no-cache-dir \
      fastapi uvicorn "sentence-transformers>=3.3" torch --extra-index-url https://download.pytorch.org/whl/cpu

COPY deploy/reranker/app.py ./app.py

# Bake the model into the image: the pull is ~2GB, and doing it at boot makes a cold
# schedule look like an outage.
RUN python -c "from sentence_transformers import CrossEncoder; CrossEncoder('BAAI/bge-reranker-v2-m3')"

RUN useradd --create-home --uid 10001 ferret && chown -R ferret /srv
USER ferret

EXPOSE 8081
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8081"]
